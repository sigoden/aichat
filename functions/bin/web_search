#!/bin/sh

# Web search tool using SearXNG
# Expects a JSON string as the first argument, e.g., {"query": "search terms"}
# Outputs a JSON string representing search results

# Configuration
SEARXNG_URL="${SEARXNG_URL:-http://localhost:8080}"
TIMEOUT=10

# Resolve the manage_searxng.sh script path relative to this script's location.
# This script lives in <repo>/functions/bin/, so the repo root is two levels up.
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/../.." 2>/dev/null && pwd)"
MANAGE_SCRIPT="${REPO_ROOT}/scripts/searxng/manage_searxng.sh"

# Extract the query
if command -v jq >/dev/null 2>&1; then
    query=$(echo "$1" | jq -r '.query')
else
    # Fallback: simple parsing, might fail on complex JSON
    query=$(echo "$1" | sed -n 's/.*"query"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
fi

if [ -z "$query" ] || [ "$query" = "null" ]; then
    echo '{"error": "No query provided", "results": []}'
    exit 1
fi

# URL-encode the query using python3 (already required by the project) for correctness.
# Falls back to a basic sed replacement if python3 is unavailable.
if command -v python3 >/dev/null 2>&1; then
    encoded_query=$(python3 -c "import urllib.parse, sys; print(urllib.parse.quote_plus(sys.argv[1]))" "$query")
else
    encoded_query=$(printf '%s' "$query" | sed 's/ /+/g')
fi

# Make the request to SearXNG
response=$(curl -s --connect-timeout 5 --max-time "$TIMEOUT" \
    -H "Accept: application/json" \
    "${SEARXNG_URL}/search?q=${encoded_query}&format=json" 2>/dev/null)

if [ $? -ne 0 ] || [ -z "$response" ]; then
    # SearXNG not available - try to auto-start using the resolved script path
    if [ ! -f "$MANAGE_SCRIPT" ]; then
        cat <<EOF
{
  "error": "SearXNG not available at ${SEARXNG_URL}. Could not find the management script at ${MANAGE_SCRIPT}.",
  "results": []
}
EOF
        exit 0
    fi

    # Auto-start SearXNG (stderr so it doesn't corrupt JSON output)
    echo "SearXNG not reachable. Attempting to start it via ${MANAGE_SCRIPT}..." >&2
    bash "$MANAGE_SCRIPT" start >&2

    if [ $? -ne 0 ]; then
        cat <<EOF
{
  "error": "Failed to auto-start SearXNG.",
  "results": []
}
EOF
        exit 0
    fi

    # Wait for it to be ready (up to 20 seconds)
    echo "Waiting for SearXNG to be ready..." >&2
    for i in $(seq 1 20); do
        curl -s -m 1 "${SEARXNG_URL}" >/dev/null 2>&1
        if [ $? -eq 0 ]; then
            echo "SearXNG is up!" >&2
            break
        fi
        sleep 1
    done

    # Retry the request
    response=$(curl -s --connect-timeout 5 --max-time "$TIMEOUT" \
        -H "Accept: application/json" \
        "${SEARXNG_URL}/search?q=${encoded_query}&format=json" 2>/dev/null)

    if [ $? -ne 0 ] || [ -z "$response" ]; then
        cat <<EOF
{
  "error": "SearXNG started but still not reachable at ${SEARXNG_URL}.",
  "results": []
}
EOF
        exit 0
    fi
fi

# Check if jq is available for proper JSON parsing
if command -v jq >/dev/null 2>&1; then
    # Use jq for proper JSON extraction
    echo "$response" | jq -c '{
        results: [.results[:10][] | {
            title: .title,
            url: .url,
            snippet: (.content // .snippet // "No description available")
        }]
    }' 2>/dev/null
    
    if [ $? -ne 0 ]; then
        # jq failed, response might not be valid JSON
        echo '{"error": "Invalid response from SearXNG", "results": []}'
    fi
else
    # Fallback: basic parsing without jq
    # Extract up to 5 results using sed/awk (limited but works)
    echo "$response" | grep -o '"title":"[^"]*"' | head -5 | while read -r line; do
        title=$(echo "$line" | sed 's/"title":"\([^"]*\)"/\1/')
        echo "  - $title"
    done
    
    # For actual JSON output, we need jq - output a warning
    cat <<EOF
{
  "warning": "Install jq for better JSON parsing",
  "raw_response_available": true,
  "results": []
}
EOF
fi
